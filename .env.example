# Copy to .env (root) — read by apps/worker, packages/db, apps/web (server only)

# Anthropic API — all reasoning passes (claude-opus-5-5)
ANTHROPIC_API_KEY=

# Neon Postgres (pooled connection string). Optional for replays: without it the
# worker writes events to .data/*.events.jsonl instead.
DATABASE_URL=

# Signed role links (console / cockpit / stage). Any long random string.
ROLE_LINK_SECRET=

# Hosted ASR fallback for services/capture (optional)
DEEPGRAM_API_KEY=


# Bearer token for services/capture → POST /api/events (also set on Vercel)
CAPTURE_TOKEN=

# Operator key for web writes (console, /new); open the site once with ?key=<value>
OPERATOR_KEY=

# Host access (spec §3): password for /host/** and signing secret for the adl_host cookie
HOST_PASSWORD=
HOST_SIGNING_SECRET=

# LLM provider: subscription (default; headless Claude Code on your plan) | api (needs LLM_API_BUDGET_USD) | cache
LLM_PROVIDER=subscription
LLM_API_BUDGET_USD=
